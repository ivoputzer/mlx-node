{
  "name": "mlx-swift",
  "description": "The foundational Node.js bridge to Apple's MLX framework via Swift. Native Apple Silicon acceleration with zero-dependency Node-API bindings.",
  "version": "0.0.0-draft.0",
  "type": "module",
  "exports": {
    "require": "./mlx.node",
    "import": "./index.js"
  },
  "files": [
    "index.js",
    "mlx.node",
    "default.metallib"
  ],
  "scripts": {
    "build": "bash build.sh",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "keywords": [
    "mlx",
    "swift",
    "apple-silicon",
    "metal",
    "node-api",
    "native-bindings",
    "macos-m1",
    "macos-m2",
    "macos-m3",
    "macos-m4",
    "macos-m5"
  ],
  "author": "Ivo von Putzer Reibegg <ivo.putzer@gmail.com> (https://github.com/ivoputzer)",
  "license": "WTFNMFPL"
}
